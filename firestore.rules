rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 限定公開: 許可リスト(allowlist)のuidのみ、自分のドキュメントを読み書き可。
    // ↓の配列に src/access.ts と同じ uid を入れること（複数可: ["uid1", "uid2"]）。
    match /sizing/{uid} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.uid in ["c3cbU6J4jwWPJDsXWNETk3iMPpz1"];
    }
    // 上記以外は全拒否（デフォルト）
  }
}
